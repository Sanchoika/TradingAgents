[Unit]
Description=Trading phone control page (localhost only; Tailscale Serve in front)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/ta-brent
Environment=PYTHONPATH=/root/ta-brent
# notify_command runs `hermes`, installed in /root/.local/bin, which systemd does not put on PATH
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/root/TradingAgents/.venv/bin/python -m tradingagents.control --config /root/ta-brent/control.toml serve
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
