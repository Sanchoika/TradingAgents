# Brent news collector + classifier (no OANDA token; uses the ChatGPT sign-in file).
[Unit]
Description=Brent news collector
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/root/ta-brent
Environment=PYTHONPATH=/root/ta-brent
# notify_command runs `hermes`, installed in /root/.local/bin, which systemd does not put on PATH
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/root
ExecStart=/root/TradingAgents/.venv/bin/python -m tradingagents.brent --config /root/ta-brent/brent.toml news-check --analyze
Restart=on-failure
RestartSec=20
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
